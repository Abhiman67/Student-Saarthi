datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  name                String
  onboardingCompleted Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  profile             Profile?
  conversations       Conversation[]
  projects            Project[]
  tasks               Task[]
  files               File[]
  applications        Application[]
  approvals           Approval[]
  usageEvents         UsageEvent[]
  auditEvents         AuditEvent[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  institution  String?
  degree       String?
  semester     String?
  goals        String?
  subjects     String?
  skills       String?
  interests    String?
  studyHours   Int?
  careerTarget String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id            String         @id
  name          String
  role          String
  description   String
  category      String
  icon          String
  systemPrompt  String
  isSystem      Boolean        @default(true)
  isFutureScope Boolean        @default(false)
  createdAt     DateTime       @default(now())

  conversations Conversation[]
  tasks         Task[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  agentId   String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id])
  messages  Message[]
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  role             String       // "user" | "assistant" | "system"
  content          String
  citations        String?      // JSON string array
  approvalRequired Boolean      @default(false)
  approvalId       String?
  createdAt        DateTime     @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Project {
  id             String    @id @default(cuid())
  userId         String
  name           String
  description    String?
  type           String    // Coursework, Major Project, Research, Self-Study
  status         String    // Planning, In Progress, Review, Completed
  targetDate     DateTime?
  linkedAgentIds String?   // JSON string array of agent IDs
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  agentId     String?
  title       String
  description String?
  dueDate     DateTime?
  priority    String    // Low, Medium, High, Urgent
  status      String    // Pending, In Progress, Completed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model File {
  id            String    @id @default(cuid())
  userId        String
  name          String
  type          String    // application/pdf, text/plain, text/markdown, docx
  size          Int
  path          String?
  extractedText String?
  summary       String?
  flashcards    String?   // JSON string array of {question, answer}
  quiz          String?   // JSON string array of {question, options, answer}
  status        String    // Processed, Failed, Processing
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id               String    @id @default(cuid())
  userId           String
  company          String
  role             String
  url              String?
  status           String    // Wishlist, Applied, Interviewing, Offer, Rejected
  notes            String?
  resumeFeedback   String?
  coverLetterDraft String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Approval {
  id            String    @id @default(cuid())
  userId        String
  actionType    String    // CREATE_TASK, MODIFY_PROJECT, DRAFT_COVER_LETTER, FILE_ACTION
  description   String
  payload       String    // JSON string containing action parameters
  status        String    // Pending, Approved, Denied
  decisionNotes String?
  createdAt     DateTime  @default(now())
  decidedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String   // MESSAGE_SENT, FILE_UPLOADED, AGENT_ACCESSED
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
